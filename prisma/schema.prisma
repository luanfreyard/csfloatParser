// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Item {
  id             Int           @id @default(autoincrement())
  name           String
  marketHashName String
  image          String?
  weapon         String?
  category       String?
  pattern        String?
  wear           String?
  rarity         String?
  minFloat       Float?
  maxFloat       Float?
  isStatTrak     Boolean?
  isSouvenir     Boolean?
  itemHistories  ItemHistory[]
}

model ItemHistory {
  id         Int      @id @default(autoincrement())
  externalId String   @unique
  skinId     Int
  skin       Item     @relation(fields: [skinId], references: [id])
  capturedAt DateTime @default(now())

  price      Int
  assetId    String
  defIndex   Int
  paintIndex Int
  paintSeed  Int
  floatValue Float
  soldAt     DateTime

  @@index([skinId])
}
